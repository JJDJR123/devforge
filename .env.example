# ==========================================================================
# DEVFORGE 环境变量
# 复制为 .env 后修改。不要提交 .env。
# ==========================================================================

# --------------------------------------------------------------------------
# 原生部署（Node + systemd + Nginx）
# --------------------------------------------------------------------------
# 服务只监听本机，由 Nginx 反向代理。不要把 3000 端口暴露到公网。
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
DATA_DIR=./data

# 首次打开页面时要求输入的口令。请换成一串随机字符。
# 可用 `openssl rand -hex 16` 生成。
SETUP_TOKEN=replace-with-a-random-token

# 单次上传大小上限（MB）。修改后记得同步 Nginx 的 client_max_body_size。
MAX_UPLOAD_MB=25

# 日志级别：info / warn / error
LOG_LEVEL=info

# ICP 备案号（大陆服务器正式上线后填写，会显示在总览底部）
# 例如：ICP_NUMBER=浙ICP备2026000000号-1
# ICP_LINK=https://beian.miit.gov.cn/
ICP_NUMBER=
ICP_LINK=https://beian.miit.gov.cn/

# 会话 Cookie 是否强制 Secure。
# 留空 = 自动（HTTPS 时 Secure，本机 HTTP 时不 Secure）。
# 正式环境建议配置 HTTPS 后保持自动。
# COOKIE_SECURE=true

# --------------------------------------------------------------------------
# 可选：Docker Compose + Caddy
# --------------------------------------------------------------------------
# 域名（Caddy 自动申请 HTTPS 证书）或 :80（纯 HTTP / IP 测试）
SITE_ADDRESS=:80
# 公网映射端口。IP 测试时可用 8080；备案并配置域名后改为 80 / 443。
HTTP_PORT=8080
HTTPS_PORT=8443

# --------------------------------------------------------------------------
# DeepSeek AI 助手（只给管理员使用）
# API Key 只保存在服务器 .env，不会发送到浏览器。
# --------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 允许在后台切换的模型，逗号分隔
AI_MODELS=deepseek-flash,deepseek-v4-pro
AI_MAX_TOKENS=1200
