{
  "name": "devforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "description": "DEVFORGE · 独立游戏开发学习舱",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test:e2e": "node tools/e2e.mjs",
    "backup": "node server/backup.js",
    "reset-password": "node server/reset-password.js",
    "icons": "python tools/make_icons.py"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.74.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
