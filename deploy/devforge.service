[Unit]
Description=DEVFORGE - indie game dev learning workspace
After=network.target

[Service]
Type=simple
User=devforge
Group=devforge
WorkingDirectory=/opt/devforge
EnvironmentFile=/opt/devforge/.env
ExecStart=/opt/node/bin/node /opt/devforge/server/index.js
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/devforge/data

[Install]
WantedBy=multi-user.target
