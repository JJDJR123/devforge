[Unit]
Description=DEVFORGE auto update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/devforge-update
ExecStart=/opt/devforge/deploy/auto-update.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=900
StandardOutput=append:/var/log/devforge-update.log
StandardError=append:/var/log/devforge-update.log
